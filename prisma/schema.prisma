generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CONSULTANT
  CUSTOMER
}

enum BookingStatus {
  draft
  pending_payment
  payment_uploaded
  payment_under_review
  confirmed
  scheduled
  completed
  cancelled
  rescheduled
  no_show
  refunded
}

enum PaymentStatus {
  pending
  uploaded
  under_review
  confirmed
  rejected
  refunded
}

enum RoadmapStatus {
  awaiting_documents
  documents_received
  under_review
  consultation_scheduled
  consultation_completed
  roadmap_in_progress
  roadmap_ready
  delivered
}

enum ReviewStatus {
  pending
  approved
  hidden
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String
  role         Role          @default(CONSULTANT)
  avatarUrl    String?
  phone        String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  consultantProfile Consultant?
  auditLogs         AuditLog[]

  @@map("users")
}

model Consultant {
  id                   String                       @id @default(uuid())
  slug                 String?                      @unique
  userId               String                       @unique
  user                 User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                String
  initials             String?
  shortBio             String?                      @db.Text
  bio                  String                       @db.Text
  tags                 String[]                     @default([])
  languages            String[]                     @default(["العربية"])
  yearsOfExperience    Int                          @default(5)
  hourlyRate           Float                        @default(50.0)
  timezone             String                       @default("Asia/Gaza")
  isActive             Boolean                      @default(true)
  isAutoAssignEligible Boolean                      @default(true)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  specialties          ConsultantSpecialty[]
  services             ConsultantService[]
  availabilityRules    AvailabilityRule[]
  blockedSlots         BlockedSlot[]
  bookings             Booking[]
  googleConnection     GoogleCalendarConnection?
  notes                ConsultantNote[]
  roadmaps             Roadmap[]

  @@map("consultants")
}

model Specialty {
  id          String                @id @default(uuid())
  slug        String                @unique
  nameAr      String
  nameEn      String?
  description String?               @db.Text
  icon        String?
  orderIndex  Int                   @default(0)
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  consultants ConsultantSpecialty[]

  @@map("specialties")
}

model ConsultantSpecialty {
  id           String     @id @default(uuid())
  consultantId String
  specialtyId  String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  specialty    Specialty  @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@unique([consultantId, specialtyId])
  @@map("consultant_specialties")
}

model Service {
  id               String              @id @default(uuid())
  slug             String              @unique
  nameAr           String
  nameEn           String?
  descriptionAr    String              @db.Text
  durationMinutes  Int
  price            Float
  currency         String              @default("USD")
  isPopular        Boolean             @default(false)
  isComprehensive  Boolean             @default(false)
  features         String[]
  isActive         Boolean             @default(true)
  orderIndex       Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  consultantServices ConsultantService[]
  bookings           Booking[]

  @@map("services")
}

model ConsultantService {
  id           String     @id @default(uuid())
  consultantId String
  serviceId    String
  customPrice  Float?
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  service      Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([consultantId, serviceId])
  @@map("consultant_services")
}

model Customer {
  id            String     @id @default(uuid())
  fullName      String
  email         String
  whatsappPhone String
  country       String
  age           Int?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  bookings      Booking[]
  documents     Document[]

  @@index([email])
  @@index([whatsappPhone])
  @@map("customers")
}

model Booking {
  id                 String               @id @default(uuid())
  bookingReference   String               @unique
  customerId         String
  customer           Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  consultantId       String?
  consultant         Consultant?          @relation(fields: [consultantId], references: [id], onDelete: SetNull)
  serviceId          String
  service            Service              @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  isAutoAssign       Boolean              @default(false)
  status             BookingStatus        @default(draft)
  slotStartTime      DateTime             // UTC
  slotEndTime        DateTime             // UTC
  customerTimezone   String               @default("Asia/Gaza")
  slotExpiresAt      DateTime?            // Lock release timer for unpaid slots
  caseDescription    String               @db.Text
  primaryQuestion    String               @db.Text
  desiredOutcome     String               @db.Text
  additionalNotes    String?              @db.Text
  meetingLink        String?
  googleEventId      String?
  cancellationReason String?              @db.Text
  cancelledAt        DateTime?
  completedAt        DateTime?
  rescheduledFromId  String?
  reminder24hSent    Boolean              @default(false)
  reminder1hSent     Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  statusHistory      BookingStatusHistory[]
  payment            Payment?
  documents          BookingDocument[]
  notes              ConsultantNote[]
  calendarEvent      CalendarEvent?
  roadmap            Roadmap?
  review             Review?

  @@index([slotStartTime, slotEndTime])
  @@index([status])
  @@index([slotExpiresAt])
  @@map("bookings")
}

model BookingStatusHistory {
  id        String        @id @default(uuid())
  bookingId String
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus BookingStatus
  toStatus  BookingStatus
  changedBy String?
  note      String?       @db.Text
  createdAt DateTime      @default(now())

  @@map("booking_status_history")
}

model AvailabilityRule {
  id             String     @id @default(uuid())
  consultantId   String
  consultant     Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  dayOfWeek      Int        // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime      String     // HH:mm format e.g. "09:00"
  endTime        String     // HH:mm format e.g. "17:00"
  breakStartTime String?    // HH:mm format
  breakEndTime   String?    // HH:mm format
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([consultantId, dayOfWeek])
  @@map("availability_rules")
}

model BlockedSlot {
  id            String     @id @default(uuid())
  consultantId  String
  consultant    Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  startDateTime DateTime   // UTC
  endDateTime   DateTime   // UTC
  reason        String
  isAllDay      Boolean    @default(false)
  createdAt     DateTime   @default(now())

  @@index([consultantId, startDateTime, endDateTime])
  @@map("blocked_slots")
}

model PaymentMethod {
  id             String    @id @default(uuid())
  code           String    @unique // e.g. "bop", "aib", "palpay", "jawwal_pay", "crypto", "cash_gaza", "international"
  nameAr         String
  nameEn         String?
  instructionsAr String    @db.Text
  accountDetails Json
  isActive       Boolean   @default(true)
  orderIndex     Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  payments       Payment[]

  @@map("payment_methods")
}

model Payment {
  id              String         @id @default(uuid())
  bookingId       String         @unique
  booking         Booking        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  amount          Float
  currency        String         @default("USD")
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  status          PaymentStatus  @default(pending)
  confirmedAt     DateTime?
  confirmedBy     String?
  rejectionReason String?        @db.Text
  idempotencyKey  String?        @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  proofs          PaymentProof[]

  @@map("payments")
}

model PaymentProof {
  id                String    @id @default(uuid())
  paymentId         String
  payment           Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  senderName        String
  amount            Float
  currency          String    @default("USD")
  transactionNumber String?
  paymentDate       DateTime
  receiptFilePath   String
  receiptFileName   String
  fileMime          String
  fileSize          Int
  notes             String?   @db.Text
  adminNotes        String?   @db.Text
  status            String    @default("pending") // pending, accepted, rejected
  reviewedAt        DateTime?
  reviewedBy        String?
  createdAt         DateTime  @default(now())

  @@map("payment_proofs")
}

model Document {
  id             String            @id @default(uuid())
  customerId     String?
  customer       Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  originalName   String
  storedFileName String
  filePath       String
  mimeType       String
  sizeBytes      Int
  hash           String?
  category       String            @default("other") // passport, id_card, academic, cv, official_letter, family, roadmap, other
  isConfidential Boolean           @default(true)
  uploadedBy     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  bookings       BookingDocument[]
  roadmapFiles   Roadmap[]

  @@map("documents")
}

model BookingDocument {
  id         String   @id @default(uuid())
  bookingId  String
  documentId String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([bookingId, documentId])
  @@map("booking_documents")
}

model ConsultantNote {
  id                 String     @id @default(uuid())
  bookingId          String
  booking            Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  consultantId       String
  consultant         Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  content            String     @db.Text
  isSharedWithAdmin  Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@map("consultant_notes")
}

model GoogleCalendarConnection {
  id             String     @id @default(uuid())
  consultantId   String     @unique
  consultant     Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  email          String
  accessToken    String     @db.Text
  refreshToken   String     @db.Text
  tokenExpiresAt DateTime?
  calendarId     String     @default("primary")
  syncStatus     String     @default("active") // active, disconnected, error
  lastSyncedAt   DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("google_calendar_connections")
}

model CalendarEvent {
  id               String   @id @default(uuid())
  bookingId        String   @unique
  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  googleEventId    String
  googleCalendarId String   @default("primary")
  htmlLink         String?
  meetLink         String?
  status           String   @default("synced") // synced, updated, cancelled
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("calendar_events")
}

model Roadmap {
  id                        String        @id @default(uuid())
  bookingId                 String        @unique
  booking                   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  consultantId              String
  consultant                Consultant    @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  status                    RoadmapStatus @default(awaiting_documents)
  summary                   String?       @db.Text
  currentSituation          String?       @db.Text
  analysis                  String?       @db.Text
  optionsAndPaths           String?       @db.Text
  recommendedOpportunities  String?       @db.Text
  requiredDocuments         String?       @db.Text
  strengths                 String?       @db.Text
  weaknessesOrGaps          String?       @db.Text
  nextSteps                 String?       @db.Text
  priorities                String?       @db.Text
  roadmapDocumentId         String?
  roadmapDocument           Document?     @relation(fields: [roadmapDocumentId], references: [id], onDelete: SetNull)
  downloadToken             String?       @unique
  deliveredAt               DateTime?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  @@map("roadmaps")
}

model Review {
  id           String       @id @default(uuid())
  bookingId    String       @unique
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerName String
  rating       Int          @default(5)
  comment      String?      @db.Text
  status       ReviewStatus @default(pending)
  isFeatured   Boolean      @default(false)
  approvedBy   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("reviews")
}

model FAQ {
  id         String   @id @default(uuid())
  questionAr String   @db.Text
  questionEn String?  @db.Text
  answerAr   String   @db.Text
  answerEn   String?  @db.Text
  category   String   @default("general")
  orderIndex Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("faqs")
}

model SiteSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  category    String   @default("general")
  isEncrypted Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@map("site_settings")
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName String?
  action    String
  entity    String
  entityId  String?
  oldValue  String?  @db.Text
  newValue  String?  @db.Text
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model JobQueue {
  id             String    @id @default(uuid())
  type           String
  payload        String    @db.Text
  status         String    @default("pending") // pending, processing, completed, failed
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  lastError      String?   @db.Text
  idempotencyKey String?   @unique
  scheduledFor   DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, scheduledFor])
  @@map("job_queue")
}

model Notification {
  id            String   @id @default(uuid())
  recipientType String   @default("admin") // admin, consultant, all
  recipientId   String?
  title         String
  message       String   @db.Text
  type          String
  linkUrl       String?
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([recipientType, recipientId, isRead])
  @@map("notifications")
}
